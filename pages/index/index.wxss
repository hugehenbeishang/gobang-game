/**index.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  margin-bottom: 40rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.welcome-section .title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.welcome-section .subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 用户信息区域 */
.user-section {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid #4a90e2;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-secondary {
  background-color: #6c757d;
  width: 100%;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #fff;
  border: none;
  margin-top: 10rpx;
}

/* 登录区域 */
.login-section {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  text-align: center;
}

.login-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
}

/* 游戏功能区域 */
.game-section {
  width: 100%;
}

.card {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #eee;
}

.card-content {
  display: flex;
  flex-direction: column;
}

.form-item {
  margin-bottom: 25rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #4a90e2;
}

/* 棋色选择器 */
.color-picker {
  display: flex;
  justify-content: space-around;
  margin-top: 15rpx;
}

.color-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 15rpx;
  width: 200rpx;
}

.color-option.selected {
  border-color: #4a90e2;
  background-color: rgba(74, 144, 226, 0.1);
}

.color-option text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #333;
}

.chess-piece {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.chess-piece.black {
  background: radial-gradient(circle at 30% 30%, #555, #000);
  box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.chess-piece.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
  border: 2rpx solid #ccc;
  box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 按钮样式 */
.btn {
  width: 100%;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  border: none;
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
}

.btn-success {
  background: linear-gradient(135deg, #28a745 0%, #218838 100%);
}

.btn-warning {
  background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
  color: #333;
}

/* 底部信息 */
.footer {
  margin-top: auto;
  padding: 30rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}