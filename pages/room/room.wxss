/**room.wxss**/
.room-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
  padding: 30rpx;
}

/* 房间信息 */
.room-header {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.room-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.room-code {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.code-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 15rpx;
}

.code-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #4a90e2;
  letter-spacing: 5rpx;
  margin-right: 20rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #4a90e2;
  background: none;
  border: 2rpx solid #4a90e2;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  line-height: 1.2;
}

/* 玩家列表 */
.players-section {
  width: 100%;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-align: center;
}

.player-card {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.player-card.occupied {
  border-left: 8rpx solid #4a90e2;
}

.player-card.empty {
  border-left: 8rpx solid #ddd;
  opacity: 0.8;
}

.player-info {
  display: flex;
  align-items: center;
}

.chess-piece {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.chess-piece.black {
  background: radial-gradient(circle at 30% 30%, #555, #000);
  box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.chess-piece.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
  border: 2rpx solid #ccc;
  box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.player-details {
  display: flex;
  flex-direction: column;
}

.player-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-status {
  font-size: 24rpx;
  color: #666;
  margin-top: 5rpx;
}

.player-action {
  margin-top: 15rpx;
  text-align: center;
}

.waiting-text {
  font-size: 26rpx;
  color: #999;
  font-style: italic;
}

/* 房间状态 */
.room-status {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.status-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

/* 操作按钮 */
.room-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 15rpx;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn:disabled {
  opacity: 0.6;
  background: #ccc !important;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #fff;
}

.action-btn.secondary {
  background: linear-gradient(135deg, #28a745 0%, #218838 100%);
  color: #fff;
}

.action-btn.danger {
  background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
  color: #fff;
}

/* 分享提示 */
.share-tip {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 15rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.share-tip text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.share-btn {
  width: 300rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  color: #fff;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

/* 等待提示 */
.waiting-tip {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 15rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.waiting-tip text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #4a90e2;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}