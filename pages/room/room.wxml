<!--pages/room/room.wxml-->
<view class="room-container">
  <!-- 房间信息 -->
  <view class="room-header">
    <view class="room-title">房间: {{roomInfo.name || '未命名房间'}}</view>
    <view class="room-code">
      <text class="code-label">房间号:</text>
      <text class="code-value">{{roomCode}}</text>
      <button class="copy-btn" bindtap="copyRoomCode">复制</button>
    </view>
  </view>

  <!-- 玩家列表 -->
  <view class="players-section">
    <view class="section-title">玩家列表</view>
    
    <!-- 黑方玩家 -->
    <view class="player-card {{blackPlayer ? 'occupied' : 'empty'}}">
      <view class="player-info">
        <view class="chess-piece black"></view>
        <view class="player-details">
          <text class="player-name">{{blackPlayer.name || '等待加入...'}}</text>
          <text class="player-status" wx:if="{{blackPlayer}}">{{blackPlayer.isMe ? '(我)' : ''}}</text>
        </view>
      </view>
      <view class="player-action" wx:if="{{!blackPlayer}}">
        <text class="waiting-text">等待黑方加入</text>
      </view>
    </view>

    <!-- 白方玩家 -->
    <view class="player-card {{whitePlayer ? 'occupied' : 'empty'}}">
      <view class="player-info">
        <view class="chess-piece white"></view>
        <view class="player-details">
          <text class="player-name">{{whitePlayer.name || '等待加入...'}}</text>
          <text class="player-status" wx:if="{{whitePlayer}}">{{whitePlayer.isMe ? '(我)' : ''}}</text>
        </view>
      </view>
      <view class="player-action" wx:if="{{!whitePlayer}}">
        <text class="waiting-text">等待白方加入</text>
      </view>
    </view>
  </view>

  <!-- 房间状态 -->
  <view class="room-status">
    <text class="status-text">{{roomStatus}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="room-actions">
    <!-- 房主操作 -->
    <block wx:if="{{isCreator}}">
      <button class="action-btn primary" bindtap="startGame" disabled="{{!canStartGame}}">
        开始游戏
      </button>
      <button class="action-btn secondary" bindtap="inviteFriend">
        邀请好友
      </button>
    </block>
    
    <!-- 加入者操作 -->
    <block wx:else>
      <button class="action-btn primary" bindtap="readyGame" disabled="{{isReady}}">
        {{isReady ? '已准备' : '准备'}}
      </button>
    </block>
    
    <button class="action-btn danger" bindtap="leaveRoom">
      离开房间
    </button>
  </view>

  <!-- 分享提示 -->
  <view class="share-tip" wx:if="{{isCreator && !whitePlayer}}">
    <text>将房间号分享给好友即可邀请对战</text>
    <button class="share-btn" open-type="share">分享给好友</button>
  </view>

  <!-- 等待开始提示 -->
  <view class="waiting-tip" wx:if="{{!canStartGame && isCreator}}">
    <text>等待对手加入并准备...</text>
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>
</view>