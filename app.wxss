/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #333;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  background-color: #4a90e2;
  border: none;
  margin: 20rpx 0;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background-color: #4a90e2;
}

.btn-success {
  background-color: #28a745;
}

.btn-danger {
  background-color: #dc3545;
}

.btn-warning {
  background-color: #ffc107;
  color: #333;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 30rpx;
  margin: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

/* 文本样式 */
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.loading-text {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #666;
}